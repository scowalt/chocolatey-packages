{
  "name": "chocolatey-packages",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "repository": "https://github.com/scowalt/chocolatey-packages.git",
  "license": "MIT",
  "scripts": {
    "check": "bun src/bin/check.ts",
    "verify": "bun src/bin/verify.ts",
    "daily:plan": "bun src/bin/plan.ts",
    "daily:install": "bun src/bin/install.ts",
    "daily:publish": "bun src/bin/publish.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:comments": "uv run --no-project --python 3.14 --with-requirements .comment-policy/requirements.txt python .comment-policy/check.py"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  }
}
